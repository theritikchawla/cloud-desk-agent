# Copy this file to ".env" and put your real key in ".env" (never in this file).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Shows the "Developer" page (tickets + feedback stats). Set to false to hide it.
DEVELOPER_MODE=true
MIN_SCORE_EMBEDDINGS=0.30
